{
  "cli": {
    "version": ">= 16.0.1",
    "appVersionSource": "remote"
  },
  "build": {
    "ios-simulator": {
      "distribution": "internal",
      "channel": "ios-preview",
      "environment": "preview",
      "ios": {
        "simulator": true,
        "resourceClass": "medium",
        "image": "macos-tahoe-26.5-xcode-26.6"
      }
    },
    "ios-device-unsigned": {
      "distribution": "internal",
      "channel": "ios-preview",
      "environment": "preview",
      "ios": {
        "withoutCredentials": true,
        "resourceClass": "medium",
        "image": "macos-tahoe-26.5-xcode-26.6",
        "config": "ios-unsigned.yml"
      }
    },
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "environment": "development",
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "environment": "preview",
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "environment": "production",
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "internal",
        "releaseStatus": "completed"
      }
    }
  }
}
