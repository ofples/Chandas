{
  "name": "chandas",
  "version": "2.1.0",
  "main": "index.ts",
  "dependencies": {
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@expo/metro-runtime": "~57.0.15",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/slider": "5.2.0",
    "expo": "~57.0.20",
    "expo-asset": "~57.0.3",
    "expo-audio": "~57.0.4",
    "expo-dev-client": "~57.0.18",
    "expo-font": "~57.0.0",
    "expo-haptics": "^57.0.2",
    "expo-keep-awake": "~57.0.0",
    "expo-notifications": "~57.0.17",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.21",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "vitest run --pool=threads --maxWorkers=1",
    "test:watch": "vitest",
    "prebuild": "expo prebuild",
    "prebuild:clean": "expo prebuild --clean",
    "release:check": "expo install --check && tsc --noEmit && npm test",
    "build:android:dev": "eas build --profile development --platform android",
    "build:android:preview": "eas build --profile preview --platform android",
    "build:android:prod": "eas build --profile production --platform android",
    "submit:android:prod": "eas submit --profile production --platform android",
    "publish:preview": "eas update --channel preview --platform android --environment preview",
    "publish:production": "eas update --channel production --platform android --environment production",
    "promote:preview:production": "eas update:republish --channel preview --destination-channel production --platform android",
    "rollback:production": "eas update:rollback --platform android",
    "workflow:production": "eas workflow:run .eas/workflows/deploy-production.yml"
  },
  "private": true
}
