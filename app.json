{
  "expo": {
    "name": "SlotTimer",
    "slug": "slottimer",
    "version": "0.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "slottimer",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.slottimer.app"
    },
    "android": {
      "package": "com.slottimer.app",
      "adaptiveIcon": {
        "backgroundColor": "#0b0c10",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "POST_NOTIFICATIONS",
        "WAKE_LOCK",
        "USE_FULL_SCREEN_INTENT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-audio",
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#7c6ff7"
        }
      ],
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "backgroundColor": "#0b0c10",
          "dark": {
            "backgroundColor": "#0b0c10"
          }
        }
      ],
      "./modules/slot-timer-service/app.plugin.js"
    ]
  }
}
