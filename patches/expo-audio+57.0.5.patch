diff --git a/node_modules/expo-audio/src/AudioPlayer.web.ts b/node_modules/expo-audio/src/AudioPlayer.web.ts
--- a/node_modules/expo-audio/src/AudioPlayer.web.ts
+++ b/node_modules/expo-audio/src/AudioPlayer.web.ts
@@ -124,7 +124,11 @@
     if (!isAudioActive) {
       return;
     }
-    this.media.play();
+    // Removing/replacing a timer cue can interrupt a still-pending play request.
