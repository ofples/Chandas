diff --git a/node_modules/expo-audio/build/AudioPlayer.web.js b/node_modules/expo-audio/build/AudioPlayer.web.js
--- a/node_modules/expo-audio/build/AudioPlayer.web.js
+++ b/node_modules/expo-audio/build/AudioPlayer.web.js
@@ -83,7 +83,9 @@
         if (!isAudioActive) {
             return;
